   <DockPanel Margin="0,15,0,0"><Button x:Name="NewDownloadButton" DockPanel.Dock="Right" Content="↓  开始 IPv6 下载" Background="{DynamicResource Soft}" Foreground="{DynamicResource Accent}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="SampleSources" Width="158" Height="32" DisplayMemberPath="Label"/><Button x:Name="LoadSample" Content="填入已验证样本" FontSize="11" Padding="10,6" Margin="8,0,0,0"/></StackPanel></DockPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource Section}"><StackPanel>
   <DockPanel><Button x:Name="OpenDownloads" DockPanel.Dock="Right" Content="打开下载目录" FontSize="11" Padding="10,6"/><TextBlock Text="下载任务" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <TextBlock x:Name="ResearchSummary" Text="正在读取任务…" Style="{StaticResource Note}" FontSize="11" Margin="0,8,0,10"/>
   <ListView x:Name="JobsList" Height="185" FontSize="11"><ListView.View><GridView><GridViewColumn Header="文件" Width="240" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="来源" Width="100" DisplayMemberBinding="{Binding Source}"/><GridViewColumn Header="状态" Width="75" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="进度" Width="180" DisplayMemberBinding="{Binding Progress}"/></GridView></ListView.View></ListView>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="PauseJob" Content="暂停" Padding="12,6" Margin="0,0,8,0"/><Button x:Name="ResumeJob" Content="继续 / 重试" Padding="12,6" Margin="0,0,8,0"/><Button x:Name="JobDetails" Content="详情与校验" Padding="12,6"/></StackPanel>
   <TextBlock x:Name="DownloadLocation" Style="{StaticResource Note}" FontSize="10" Margin="0,10,0,0"/>
  </StackPanel></Border>
  <TextBlock Text="仅支持来源检测中登记的域名。需要登录的文件请使用已有权限的有效直链；此版不导入浏览器登录状态。" Style="{StaticResource Note}" FontSize="11"/>
 </StackPanel>
</ScrollViewer>
<ScrollViewer x:Name="DiagnosticsScroll" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
 <StackPanel>
  <TextBlock Text="来源检测" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="登记来源不是可用承诺。只有真实文件样本通过，才会进入下载页的已验证样本列表。" Style="{StaticResource Note}" Margin="0,7,0,16"/>
  <Border Style="{StaticResource Section}"><StackPanel>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ValidateSourceFile" Content="验证实际文件" Padding="10,7" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="CheckSource" Content="重新检测" Padding="10,7" Margin="0,0,8,0"/><Button x:Name="CheckAllSources" Content="检测全部" Foreground="{DynamicResource Accent}" Padding="10,7"/></StackPanel><TextBox x:Name="SourceSearch" Width="200" Height="34" HorizontalAlignment="Left" Padding="9,6" ToolTip="按来源、分类或状态筛选"/></DockPanel>
   <TextBlock x:Name="DiagnosticSummary" Text="正在读取检测结果…" Style="{StaticResource Note}" FontSize="11" Margin="0,12,0,9"/>
   <ListView x:Name="SourcesList" Height="350" FontSize="12"><ListView.View><GridView><GridViewColumn Header="来源" Width="215" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="类别" Width="130" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="本机检测结果" Width="145" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView>
   <Border Background="{DynamicResource Soft}" Padding="14" CornerRadius="12" Margin="0,14,0,0"><TextBlock x:Name="SourceDetail" Text="选择一项，查看检测结果、接入范围和下载域名。" Style="{StaticResource Note}" FontSize="11"/></Border>
  </StackPanel></Border>
  <Button x:Name="ProxyHelp" Content="查看 pip / 下载客户端接入方法" HorizontalAlignment="Left"/>
  <TextBlock Text="检测通过只代表该样本。DNS、文件连接、完整文件校验分别记录；源站无 IPv6 时不能强行变为原生 IPv6。" Style="{StaticResource Note}" Margin="0,12,0,0" FontSize="11"/>
 </StackPanel>
</ScrollViewer>

 </Grid>
 <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel><TextBlock Text="v0.8.0  ·  IPv6 ONLY  ·  本地运行" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="FooterStatus" Text="正在准备本地服务…" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 <Grid x:Name="Overlay" Grid.RowSpan="3" Background="#650F172A" Visibility="Collapsed"><Border Width="650" MaxHeight="690" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="24" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><DockPanel><Button x:Name="DismissDialog" Content="关闭" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,18,0,0"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DialogContent"/></ScrollViewer></DockPanel></Border></Grid>
</Grid></Border></Window>


